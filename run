"""CBO Seeder launcher.

    python run cbo                              open the web page
    python run cbo --port 8600                  open the web page on another port
"""
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
VENV_PYTHON = HERE / ".venv" / "Scripts" / "python.exe"
USAGE = __doc__.strip()


def main():
    args = sys.argv[1:]
    if not args or args[0] != "cbo":
        print(USAGE)
        return 1

    if not VENV_PYTHON.exists():
        print("The .venv folder is missing. Set it up first, see README.md.")
        return 1

    # Always run with the project's .venv, even when started with the global "python"
    options = args[1:]
    if not options:
        command = ["-m", "streamlit", "run", "ui.py"]
    elif options[0] == "--port" and len(options) == 2 and options[1].isdigit():
        command = ["-m", "streamlit", "run", "ui.py", "--server.port", options[1]]
    else:
        print(USAGE)
        return 1
    try:
        return subprocess.call([str(VENV_PYTHON), *command], cwd=HERE)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
